map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

server {

    listen       80;
    server_name {{ jupyterhub_server_name }};
    return 301 https://{{ jupyterhub_server_name }}$request_uri;
}

server {

    listen   443 ssl;
    ssl_certificate        {{ jupyterhub_ssl_certificate }};
    ssl_certificate_key    {{ jupyterhub_ssl_certificate_key }};
    server_name  {{ jupyterhub_server_name }};

    location / {

        proxy_pass {{ jupyterhub_proxy_target }};

        proxy_redirect   off;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;

        # websocket headers
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
