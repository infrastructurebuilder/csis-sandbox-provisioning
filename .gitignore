# What this repository's own build and tests leave behind. Nothing else is
# ignored: a file that turns up here unasked should be seen.
.DS_Store
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
dist/
# The collections `just init` installs from requirements.yml.
.collections/
# Per-machine agent settings; the shared Spec Kit skills under .claude/skills are tracked.
.claude/settings.local.json
